COMPOSE_PROJECT_NAME=folio-platform-minimal

# database configuration
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-postgres_admin}
KC_DB_PASSWORD=${KC_DB_PASSWORD:-keycloak_admin}
KONG_DB_PASSWORD=${KONG_DB_PASSWORD:-kong_admin}
OKAPI_DB_PASSWORD=${OKAPI_DB_PASSWORD:-okapi_admin}
MGR_APPLICATIONS_DB_PASSWORD=${MGR_APPLICATIONS_DB_PASSWORD:-mgr_applications_admin}
MGR_TENANTS_DB_PASSWORD=${MGR_TENANTS_DB_PASSWORD:-mgr_tenants_admin}
MGR_TENANT_ENTITLEMENTS_DB_PASSWORD=${MGR_TENANT_ENTITLEMENTS_DB_PASSWORD:-mgr_tenant_entitlements_admin}

# mgr-components configuration
MGR_COMPONENTS_SECURITY_ENABLED=${MGR_COMPONENTS_SECURITY_ENABLED:-false}
MGR_COMPONENTS_KEYCLOAK_IMPORT_ENABLED=${MGR_COMPONENTS_KEYCLOAK_IMPORT_ENABLED:-true}
MGR_COMPONENTS_KC_INTEGRATION_ENABLED=${MGR_COMPONENTS_KC_INTEGRATION_ENABLED:-true}
MGR_COMPONENTS_KONG_INTEGRATION_ENABLED=${MGR_COMPONENTS_KONG_INTEGRATION_ENABLED:-true}

# keycloak configuration
KC_ADMIN_PASSWORD=${KC_ADMIN_PASSWORD:-admin}
KC_ADMIN_CLIENT_ID=${KC_ADMIN_CLIENT_ID:-folio-backend-admin-client}
KC_ADMIN_CLIENT_SECRET=${KC_ADMIN_CLIENT_SECRET:-folio-backend-admin-client-secret}
KC_LOGIN_CLIENT_SUFFIX=${KC_LOGIN_CLIENT_SUFFIX:--login-app}
KC_SERVICE_CLIENT_ID=${KC_SERVICE_CLIENT_ID:-m2m-client}

# keycloak image (FOLIO's Keycloak distribution; pulls from registry by default).
# Override with a locally-built tag if you build Keycloak yourself.
FOLIO_KEYCLOAK_IMAGE=${FOLIO_KEYCLOAK_IMAGE:-folioci/folio-keycloak:latest}

# Kong image (FOLIO's Kong distribution).
FOLIO_KONG_IMAGE=${FOLIO_KONG_IMAGE:-folioci/folio-kong:latest}

# secret store configuration
SECRET_STORE_TYPE=${SECRET_STORE_TYPE:-VAULT}
SECRET_STORE_VAULT_TOKEN=${SECRET_STORE_VAULT_TOKEN:-vault-token}

# don't change
OKAPI_URL=http://api-gateway:8000
SECRET_STORE_VAULT_ADDRESS=http://vault:8200

# mgr-components images
MGR_TENANTS_IMAGE=${MGR_TENANTS_IMAGE:-folioci/mgr-tenants:latest}
MGR_APPLICATIONS_IMAGE=${MGR_APPLICATIONS_IMAGE:-folioci/mgr-applications:latest}
MGR_TENANT_ENTITLEMENTS_IMAGE=${MGR_TENANT_ENTITLEMENTS_IMAGE:-folioci/mgr-tenant-entitlements:latest}

# folio-module-sidecar image. This tag is the single source of truth for the
# sidecar version. ./start.sh --native-sidecar reuses this same tag and rebuilds it
# locally from the matching upstream git tag (4.0.1 -> v4.0.1); a non-semver tag
# (latest/native/*-SNAPSHOT) builds from master. Override here (or via the shell
# env / docker/.env.local).
FOLIO_MODULE_SIDECAR_IMAGE=${FOLIO_MODULE_SIDECAR_IMAGE:-folioci/folio-module-sidecar:latest}
